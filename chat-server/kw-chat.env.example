# /etc/kw-chat.env (chmod 600). Only DEEPSEEK_API_KEY is required.
DEEPSEEK_API_KEY=
MODEL=deepseek-flash
ALLOWED_ORIGINS=https://moveisthebest.github.io
# Token budgets reset daily at 00:00 UTC. Counted tokens = uncached input + output
# + cached input x CACHE_HIT_WEIGHT.
IP_TOKENS_PER_DAY=150000
GLOBAL_TOKENS_PER_DAY=3000000
IP_REQUESTS_PER_MINUTE=6
MAX_OUTPUT_TOKENS=8000
CACHE_HIT_WEIGHT=0.02